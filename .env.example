# ========================================
# OpenVault Environment Configuration (Example)
# ========================================

# Application
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:4000/api
API_URL=http://localhost:4000/api

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-Compatible Object Storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=openvault-files
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# MeiliSearch
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=your_meili_master_key

# JWT Secrets (Generate secure random strings)
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption (Generate a secure 64-character hex string)
ENCRYPTION_SERVER_KEY=your_encryption_server_key

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password

# File Upload Limits
MAX_FILE_SIZE=5368709120
MAX_CHUNK_SIZE=10485760
DEFAULT_STORAGE_QUOTA=5368709120

# GitHub OAuth
OAUTH_GITHUB_CLIENT_ID=your_github_client_id
OAUTH_GITHUB_CLIENT_SECRET=your_github_client_secret

# Google OAuth
OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret
