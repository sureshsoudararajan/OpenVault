# ---- Build Stage ----
FROM node:20-bookworm-slim AS builder

WORKDIR /app

ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

# Copy root package files
COPY package.json package-lock.json* ./
COPY tsconfig.base.json ./

# Copy ALL package.jsons for workspace resolution
COPY packages/config/package.json ./packages/config/
COPY packages/crypto/package.json ./packages/crypto/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY apps/web/package.json ./apps/web/
COPY apps/api/package.json ./apps/api/

# Install dependencies (Cached unless package.jsons change)
# Increase NPM timeout and retries for more resilient builds
RUN npm config set registry https://registry.npmjs.org/ && \
    npm config set fetch-retry-maxtimeout 600000 && \
    npm config set fetch-retry-mintimeout 10000 && \
    npm config set fetch-retries 5 && \
    npm ci --include-workspace-root

# Copy source
COPY packages/ ./packages/
COPY apps/web/ ./apps/web/

# Build
RUN npm run build --workspace=packages/config --workspace=packages/crypto --workspace=packages/shared-types
RUN npm run build --workspace=apps/web

# ---- Production Stage ----
FROM nginx:alpine AS production

WORKDIR /app

COPY --from=builder /app/apps/web/dist/ /usr/share/nginx/html
COPY infra/docker/nginx.web.conf /etc/nginx/conf.d/default.conf

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
