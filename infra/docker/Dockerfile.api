# ---- Build Stage ----
FROM node:20-alpine AS builder

# Install python3 to satisfy youtube-dl-exec preinstall check
RUN apk add --no-cache python3 && ln -sf python3 /usr/bin/python

WORKDIR /app

# Copy root package files
COPY package.json package-lock.json* ./
COPY tsconfig.base.json ./

# Copy ALL package.jsons for workspace resolution
COPY packages/config/package.json ./packages/config/
COPY packages/crypto/package.json ./packages/crypto/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY apps/api/package.json ./apps/api/

# Install dependencies (Cached unless package.jsons change)
# Increase NPM timeout and retries for more resilient builds
RUN npm config set fetch-retry-maxtimeout 600000 && \
    npm config set fetch-retry-mintimeout 10000 && \
    npm config set fetch-retries 5 && \
    npm install --include-workspace-root

# Copy source
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/

# Generate Prisma Client
RUN npx prisma generate --schema=apps/api/prisma/schema.prisma

# Build shared packages
RUN npm run build --workspace=packages/config --workspace=packages/crypto --workspace=packages/shared-types

# Build API
RUN npm run build --workspace=apps/api

# ---- Production Stage ----
FROM node:20-alpine AS production

# Install ffmpeg for video thumbnail generation and python3 for yt-dlp before copying code to cache it
RUN apk add --no-cache ffmpeg python3

COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules/ ./node_modules/
COPY --from=builder /app/packages/ ./packages/
COPY --from=builder /app/apps/api/dist/ ./apps/api/dist/
COPY --from=builder /app/apps/api/package.json ./apps/api/
COPY --from=builder /app/apps/api/prisma/ ./apps/api/prisma/

ENV NODE_ENV=production
EXPOSE 4000

CMD ["node", "apps/api/dist/index.js"]
